# ─────────────────────────────────────────────────────────────────
# PUERTOS
# ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# ─────────────────────────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL
# ─────────────────────────────────────────────────────────────────
DB_DATABASE=factory_db
DB_USERNAME=factory_user
DB_PASSWORD=factory_secret

# ─────────────────────────────────────────────────────────────────
# URLS PÚBLICAS
# En local se pueden dejar comentadas (usan localhost por defecto).
# En un VPS hay que apuntarlas al dominio, porque el navegador del
# usuario resuelve "localhost" contra su propia máquina, no el server.
# ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://srv1875010.hstgr.cloud:8000/api
# CORS_ALLOWED_ORIGINS=http://srv1875010.hstgr.cloud:3000
