# ============================================================
# Plantilla de variables de entorno
# Uso: cp .env.example .env   y completa los valores de cada entorno
# El archivo .env NO se sube a Git (está en .gitignore)
# ============================================================

# --- Puertos publicados en el host ---
# Cada entorno en el mismo VPS necesita puertos distintos.
#   prod: 3000 / 8000 / 8080
#   dev:  3001 / 8001 / 8081
#   local: los de prod (tu PC no choca con el VPS)
FRONTEND_PORT=
BACKEND_PORT=
ADMINER_PORT=

# --- URLs públicas ---
# Usa el dominio o la IP del VPS y el puerto de ESTE entorno.
# NEXT_PUBLIC_API_URL se incrusta en el build del frontend:
# si la cambias, rebuildea con `docker compose up -d --build frontend`.
# CORS_ALLOWED_ORIGINS va sin barra final.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcional: solo si el frontend llega al backend por otra dirección interna
# INTERNAL_BACKEND_URL=http://backend:80

# --- Laravel ---
#   prod:       APP_ENV=production  APP_DEBUG=false
#   dev/local:  APP_ENV=local       APP_DEBUG=true
APP_ENV=
APP_DEBUG=false

# --- Base de datos (obligatorias) ---
# En prod usa los mismos valores que ya tiene la base existente:
# Postgres solo los aplica la primera vez que crea el volumen.
# En dev usa nombre, usuario y contraseña distintos a prod.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
